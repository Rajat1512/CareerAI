# CareerAI configuration. Copy values into your environment (or into
# Streamlit Community Cloud "Secrets") - the app does not read a .env file
# by itself. No API keys or passwords are needed.

# "file"    = save profile / saved careers / progress as JSON on this computer
# "session" = keep them only for the current browser session
#             (use this for a public deployment so visitors never share data)
CAREERAI_STORAGE=file

# Folder for the JSON files when CAREERAI_STORAGE=file (relative to the
# project folder or absolute). Default: user_data
CAREERAI_DATA_DIR=user_data
